<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dungeon Scrolling</title>
<style>
  html, body {
    margin: 0; height: 100%; background: #08070c; overflow: hidden;
  }
  body {
    display: flex; align-items: center; justify-content: center;
    font-family: ui-monospace, Consolas, monospace;
    -webkit-user-select: none; user-select: none;
  }
  canvas {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    display: block;
    box-shadow: 0 0 0 2px #1c1a2b, 0 0 48px rgba(0,0,0,.9);
  }
</style>
</head>
<body>
<canvas id="game"></canvas>

<!-- Loaded as classic scripts (not ES modules) so the game runs straight from file:// -->
<script src="./src/core/rng.js"></script>
<script src="./src/core/storage.js"></script>
<script src="./src/core/input.js"></script>
<script src="./src/core/audio.js"></script>
<script src="./src/art/base.js"></script>
<script src="./src/art/sprites.js"></script>
<script src="./src/art/biomes.js"></script>
<script src="./src/core/renderer.js"></script>
<script src="./src/systems/physics.js"></script>
<script src="./src/systems/particles.js"></script>
<script src="./src/systems/lighting.js"></script>
<script src="./src/systems/elements.js"></script>
<script src="./src/systems/modifiers.js"></script>
<script src="./src/systems/boons.js"></script>
<script src="./src/items/weapons.js"></script>
<script src="./src/items/affixes.js"></script>
<script src="./src/items/generator.js"></script>
<script src="./src/items/armor.js"></script>
<!-- Paperdoll reads DS.Armor at load, so it follows armor.js. -->
<script src="./src/art/paperdoll.js"></script>
<script src="./src/items/inventory.js"></script>
<script src="./src/world/tilemap.js"></script>
<script src="./src/world/generator.js"></script>
<script src="./src/world/hazards.js"></script>
<script src="./src/world/puzzle.js"></script>
<script src="./src/entities/base.js"></script>
<script src="./src/entities/player.js"></script>
<script src="./src/entities/enemies.js"></script>
<script src="./src/entities/enemies2.js"></script>
<script src="./src/world/bonus.js"></script>
<script src="./src/entities/boss.js"></script>
<!-- Skills capture DS.Ent / DS.Inv / DS.Weapons at load, so they come last. -->
<script src="./src/systems/skills.js"></script>
<script src="./src/ui/ui.js"></script>
<script src="./src/ui/profile.js"></script>
<script src="./src/scenes/menu.js"></script>
<script src="./src/scenes/game.js"></script>
<script src="./src/main.js"></script>
</body>
</html>
